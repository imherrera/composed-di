{
  "name": "composed-di-monorepo",
  "version": "0.13.3",
  "private": true,
  "license": "MIT",
  "author": "Juan Herrera juanhr454@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imherrera/composed-di.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "pnpm build && vitest run",
    "test:watch": "pnpm build && vitest",
    "test:types": "tsc --build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "publish:all": "pnpm lint && pnpm fmt:check && pnpm build && pnpm test && pnpm -r publish --access public",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
