{
    "name": "composed-di-monorepo",
    "version": "0.14.0",
    "private": true,
    "license": "MIT",
    "author": "Juan Herrera juanhr454@gmail.com",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/imherrera/composed-di.git"
    },
    "type": "module",
    "scripts": {
        "build": "tsc --build",
        "clean": "rm -rf packages/*/dist/ examples/*/dist/",
        "test": "pnpm build && vitest run",
        "test:watch": "pnpm build && vitest",
        "test:types": "tsc --build",
        "lint": "oxlint && node scripts/lint/check-test-file-names.mjs",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "publish:all": "pnpm clean && pnpm lint && pnpm fmt:check && pnpm build && pnpm test && pnpm -r publish --access public",
        "prepare": "pnpm build"
    },
    "devDependencies": {
        "@tsconfig/strictest": "^2.0.8",
        "@types/node": "26.2.0",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
