{
  "name": "@composed-di/instrumentation-xray",
  "version": "0.6.0-alpha",
  "private": false,
  "keywords": [
    "aws",
    "dependency injection",
    "di",
    "observability",
    "tracing",
    "x-ray",
    "xray"
  ],
  "license": "MIT",
  "author": "Juan Herrera juanhr454@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imherrera/composed-di.git",
    "directory": "packages/instrumentation-xray"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
